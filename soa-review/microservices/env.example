DB_URL=jdbc:postgresql://localhost:5432/talentsync
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-database-password
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-characters
JOB_SYNC_SECRET=replace-with-a-separate-private-service-secret-at-least-32-chars
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@talentsync.local
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SMTP_SSL_TRUST=smtp.gmail.com
APP_PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Optional local/test seed only. Also set SPRING_PROFILES_ACTIVE=dev (or test) to enable it.
# Existing accounts are never changed; use a disposable development/test database.
APP_DEMO_USERS_ENABLED=false
DEMO_USERS_CANDIDATE_EMAIL=
DEMO_USERS_CANDIDATE_PASSWORD=
DEMO_USERS_RECRUITER_EMAIL=
DEMO_USERS_RECRUITER_PASSWORD=